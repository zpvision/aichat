APP_ENV=development
# Local by default. For S3, set credentials only in your protected environment.
STORAGE_PROVIDER=local
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Validated for compatibility; signed URLs are not issued by this release.
S3_PRESIGN_TTL_SECONDS=300
# Development live tests only: integration-tests/UNIQUE_RUN_ID/ (empty in production).
S3_KEY_PREFIX=
RETENTION_SESSION_DAYS=7
# Empty disables /metrics. Set a deployment-only random token (at least 32 characters).
METRICS_TOKEN=
APP_REGION=eu
APP_BRAND_NAME=Site Assistant
DEFAULT_LOCALE=en
PUBLIC_APP_URL=http://localhost:5173
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://site_assistant:local-development-only@localhost:5432/site_assistant?sslmode=disable
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
KNOWLEDGE_FILE_ROOT=./data/knowledge
KNOWLEDGE_MAX_UPLOAD_MB=10
KNOWLEDGE_CHUNK_CHARS=2200
KNOWLEDGE_OVERLAP_CHARS=260
EMBEDDING_BATCH_SIZE=8
IMPORT_MAX_PAGES=20
IMPORT_MAX_DEPTH=2
KNOWLEDGE_MAX_SOURCES=500
KNOWLEDGE_MAX_JOBS=40
RETRIEVAL_MIN_SIMILARITY=0.4
AI_PROVIDER=mock
AI_BASE_URL=http://localhost:11434
AI_MODEL=gemma4:26b
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=500
AI_TEMPERATURE=0.3
AI_THINK=false
AI_MAX_CONCURRENT=4
AI_HISTORY_MESSAGES=20
AI_CONTEXT_CHARS=24000
AI_RAG_CHARS=12000
AI_RAG_TOP_K=5
WIDGET_PUBLIC_URL=http://localhost:8080
WIDGET_DIST_DIR=../widget/dist
WIDGET_FILE_ROOT=./data/widget
WIDGET_ALLOW_LOCALHOST=true
WIDGET_SESSION_TTL_HOURS=4
WIDGET_SESSION_MESSAGE_LIMIT=50
WIDGET_SITE_HOURLY_MESSAGES=300
WIDGET_ORG_HOURLY_MESSAGES=1000
WIDGET_SITE_CONCURRENT=2
# Base64 encoding of 32 random bytes. Required to create/deliver webhooks; keep it stable and secret.
WEBHOOK_ENCRYPTION_KEY=
# Development only: exact literal loopback URL, forbidden in production. Empty disables the exception.
WEBHOOK_DEV_RECEIVER_URL=
BILLING_TRIAL_DAYS=14
# Optional administrative CLI credential hash (SHA-256 hex). Never set the raw token in the API environment.
BILLING_ADMIN_TOKEN_HASH=
